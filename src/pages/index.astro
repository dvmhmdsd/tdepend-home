---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import { InstallSnippet } from "@/components/InstallSnippet";
import { FeatureCard } from "@/components/FeatureCard";

const features = [
  {
    icon: "ShieldCheck",
    title: "Architecture Rules",
    description:
      "Forbid imports between files or layers, keep a component's internals private, ban npm packages from parts of the code, and stop import cycles. Every violation names the file, line and import to fix.",
  },
  {
    icon: "Network",
    title: "A Graph That Matches the Compiler",
    description:
      "Every import is resolved by TypeScript's own resolver: tsconfig paths, package exports, project references and workspace packages, built or not. If tsc can follow an import, so can tdepend.",
  },
  {
    icon: "Search",
    title: "Runtime or Type-Only",
    description:
      "tdepend knows which imports really load their target at runtime and which ones the compiler erases, so a cycle made only of type imports isn't reported as a runtime cycle.",
  },
  {
    icon: "Settings",
    title: "Presets",
    description:
      "NestJS, React, Express, Fastify and plain Node projects are detected per package.json. Each preset brings sensible skips, components and recommended rules, and you can write your own.",
  },
  {
    icon: "History",
    title: "Baselines",
    description:
      "Adopt a rule in a codebase that already breaks it. The baseline accepts today's violations with a count, so only new ones fail the build.",
  },
  {
    icon: "GitBranch",
    title: "Cycles With Proof",
    description:
      "Cycles are found between files, components and packages. Each one comes with its shortest loop and the exact import behind every step.",
  },
  {
    icon: "Activity",
    title: "Coupling Metrics",
    description:
      "Afferent and efferent coupling, instability, abstractness and distance from the main sequence, for every file, component and package. Metrics inform; they never fail a build.",
  },
  {
    icon: "FileJson",
    title: "CLI, Library and JSON",
    description:
      "Run it from the command line or call it from Node. The JSON output is sorted and has no timestamp, so two runs on the same code are byte-identical.",
  },
];

const cliExample = `tdepend init        # write a starter config
tdepend analyze     # components, metrics, cycles
tdepend check       # evaluate the rules
tdepend baseline    # accept today's violations
tdepend explain src/main.ts`;

const libraryExample = `import { check } from 'tdepend';

const report = await check({ root: '.' });

for (const violation of report.actionable) {
  console.log(violation);
}
process.exitCode = report.exitCode;`;
---

<BaseLayout>
  <Hero />

  <section class="py-16 px-6 bg-muted/30">
    <div class="mx-auto text-center space-y-4 mb-12 px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Quick Installation
      </h2>
      <p class="text-lg text-muted-foreground">
        Needs Node 22.12 or later
      </p>
    </div>
    <InstallSnippet client:load />
  </section>

  <section class="py-20">
    <div class="mx-auto text-center space-y-4 mb-16 px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        What It Does
      </h2>
      <p class="text-lg text-muted-foreground">
        Rules, and the graph that makes them trustworthy
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto px-6">
      {
        features.map((feature) => (
          <FeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            client:load
          />
        ))
      }
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto text-center space-y-4 mb-12 px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Use as CLI or Library
      </h2>
      <p class="text-lg text-muted-foreground">
        Choose the approach that fits your workflow
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-6xl mx-auto px-6">
      <div class="rounded-lg border bg-background p-6 space-y-4">
        <h3 class="text-xl font-semibold">CLI Usage</h3>
        <pre class="p-4 rounded bg-muted overflow-x-auto"><code class="text-sm">{cliExample}</code></pre>
      </div>
      <div class="rounded-lg border bg-background p-6 space-y-4">
        <h3 class="text-xl font-semibold">Library Usage</h3>
        <pre class="p-4 rounded bg-muted overflow-x-auto"><code class="text-sm">{libraryExample}</code></pre>
      </div>
    </div>
  </section>

  <section class="py-20 bg-muted/30">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-lg border bg-background p-8 md:p-12 space-y-6">
        <div class="space-y-4">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
            Understanding Core Concepts
          </h2>
        </div>
        <div class="space-y-4">
          <p class="text-muted-foreground leading-relaxed">
            Learn how tdepend groups files into components, how it tells a
            runtime import from a type-only one, what the coupling metrics
            mean, how cycles are found, and how a baseline lets you adopt a
            rule gradually.
          </p>
          <div class="pt-4">
            <a href="/concepts">
              <button
                class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-8"
              >
                Explore Concepts →
              </button>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto text-center space-y-6 px-6">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Ready to write your first rule?
      </h2>
      <p class="text-lg text-muted-foreground">
        Run <code>tdepend init</code> in your repository and see what it finds.
      </p>
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4"
      >
        <a href="/docs">
          <button
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-8"
          >
            Get Started
          </button>
        </a>
        <a
          href="https://github.com/dvmhmdsd/tdepend"
          target="_blank"
          rel="noopener noreferrer"
        >
          <button
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-8"
          >
            View on GitHub
          </button>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
