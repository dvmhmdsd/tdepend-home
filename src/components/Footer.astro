---
import { Separator } from '@/components/ui/separator';
---

<footer class="border-t bg-background">
  <div class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="space-y-3">
        <h3 class="font-semibold text-lg">tdepend</h3>
        <p class="text-sm text-muted-foreground">
          Architectural fitness analysis for TypeScript projects.
        </p>
      </div>
      <div class="space-y-3">
        <h4 class="font-medium">Documentation</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors">
              Getting Started
            </a>
          </li>
          <li>
            <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors">
              Installation
            </a>
          </li>
          <li>
            <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors">
              Configuration
            </a>
          </li>
        </ul>
      </div>
      <div class="space-y-3">
        <h4 class="font-medium">Community</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/yourusername/tdepend" target="_blank" class="text-muted-foreground hover:text-foreground transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">
              Blog
            </a>
          </li>
        </ul>
      </div>
      <div class="space-y-3">
        <h4 class="font-medium">Legal</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#" class="text-muted-foreground hover:text-foreground transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="#" class="text-muted-foreground hover:text-foreground transition-colors">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>
    <Separator className="my-8" />
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted-foreground">
        © {new Date().getFullYear()} tdepend. All rights reserved.
      </p>
      <p class="text-sm text-muted-foreground">
        Built with <a href="https://astro.build" target="_blank" class="underline hover:text-foreground">Astro</a>
      </p>
    </div>
  </div>
</footer>
