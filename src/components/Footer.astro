---
import { Separator } from '@/components/ui/separator';
---

<footer class="border-t bg-background">
  <div class="p-6 md:p-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-3">
        <h3 class="font-semibold text-lg">tdepend</h3>
        <p class="text-sm text-muted-foreground">
          Architecture rules for TypeScript, checked against the import graph the compiler sees.
        </p>
      </div>
      <div class="space-y-3">
        <h4 class="font-medium">Documentation</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors">
              Getting Started
            </a>
          </li>
          <li>
            <a href="/concepts" class="text-muted-foreground hover:text-foreground transition-colors">
              Concepts
            </a>
          </li>
        </ul>
      </div>
      <div class="space-y-3">
        <h4 class="font-medium">Community</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/dvmhmdsd/tdepend" target="_blank" class="text-muted-foreground hover:text-foreground transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.npmjs.com/package/tdepend" target="_blank" class="text-muted-foreground hover:text-foreground transition-colors">
              npm
            </a>
          </li>
          <li>
            <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">
              Blog
            </a>
          </li>
        </ul>
      </div>
    </div>
    <Separator className="my-8" />
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-muted-foreground">
        © {new Date().getFullYear()} tdepend. MIT licensed.
      </p>
    </div>
  </div>
</footer>
